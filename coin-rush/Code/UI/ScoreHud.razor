@namespace Local.CoinRush
@using System;
@using System.Linq;
@using Sandbox;
@using Sandbox.UI;
@inherits PanelComponent

<root>
	<div class="card">
		<div class="icon">monetization_on</div>
		<div class="text">
			<div class="label">SCORE</div>
			<div class="value">@(Player?.Score ?? 0)</div>
		</div>
	</div>
</root>

@code
{
	public Player Player => Game.ActiveScene?.GetAllComponents<Player>().FirstOrDefault();

	protected override int BuildHash() => HashCode.Combine( Player?.Score );
}
