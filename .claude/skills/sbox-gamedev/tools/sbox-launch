#!/usr/bin/env bash
# sbox-launch — open the s&box editor on a specific project, bypassing the
# project picker. Uses protontricks-launch + the editor's -project arg.
#
# Usage:
#   sbox-launch <project-dir>                 launch (kills any running editor first)
#   sbox-launch <project-dir> --no-kill       don't kill an existing editor
#   sbox-launch <project-dir> --tail-log      stream classified log entries
#   sbox-launch <project-dir> --wait-ready    block until SkillTrigger answers a ping
#                                             (so the next tool call won't fight a still-compiling editor)
#   sbox-launch --kill                        just kill any running editor
#
# Why this exists:
#   - The Steam URI `steam://rungameid/2129370` opens the launcher; user then
#     has to click the project. Slow and not automatable.
#   - Wine's file watcher misses edits made from outside the editor, so when
#     you change project code/scenes from a script you need a fresh editor
#     to pick them up. Kill+relaunch is the reliable way.
set -e

EDITOR_APPID=2129370
EDITOR_EXE="$HOME/.steam/root/steamapps/common/sbox/sbox-dev.exe"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

KILL_FIRST=1
TAIL=0
PROJECT=""
KILL_ONLY=0
WAIT_READY=0
WAIT_READY_TIMEOUT=180

for a in "$@"; do
  case "$a" in
    --no-kill)    KILL_FIRST=0 ;;
    --tail-log|-t) TAIL=1 ;;
    --kill)       KILL_ONLY=1 ;;
    --wait-ready) WAIT_READY=1 ;;
    -h|--help)    sed -n '2,15p' "$0"; exit 0 ;;
    *)            PROJECT="$a" ;;
  esac
done

kill_editor() {
  pkill -9 -f 'sbox-dev\.exe'    2>/dev/null || true
  pkill -9 -f 'sbox-editor\.exe' 2>/dev/null || true
  sleep 1
  pkill -9 -f 'wineserver'       2>/dev/null || true
  pkill -9 -f 'pv-adverb.*sbox'  2>/dev/null || true
  sleep 2
}

if [[ $KILL_ONLY == 1 ]]; then
  echo "killing editor processes..."
  kill_editor
  echo "done"
  exit 0
fi

if [[ -z "$PROJECT" ]]; then
  echo "error: project-dir required (or pass --kill)" >&2
  exit 1
fi

PROJECT="$(realpath "$PROJECT")"
if [[ ! -d "$PROJECT" ]]; then
  echo "error: $PROJECT is not a directory" >&2
  exit 1
fi

# Find the .sbproj
SBPROJ=""
for f in "$PROJECT"/*.sbproj "$PROJECT"/.sbproj; do
  [[ -f "$f" ]] && { SBPROJ="$f"; break; }
done
if [[ -z "$SBPROJ" ]]; then
  echo "error: no .sbproj found in $PROJECT" >&2
  exit 1
fi
echo "project: $SBPROJ"

# Auto-install Editor/SkillTrigger.cs if missing. Without it, every
# sbox-eval / sbox-scene / sbox-screenshot / sbox-recompile call hangs
# silently because the editor has no extension polling the trigger
# files. This is the most common newbie failure mode for a fresh project.
if [[ ! -f "$PROJECT/Editor/SkillTrigger.cs" ]]; then
  TEMPLATE_TRIGGER="$SCRIPT_DIR/../templates/Editor/SkillTrigger.cs"
  TEMPLATE_CSPROJ="$SCRIPT_DIR/../templates/Editor/PROJECT.editor.csproj"
  if [[ -f "$TEMPLATE_TRIGGER" ]]; then
    PROJECT_NAME="$(basename "$PROJECT")"
    # snake_case ident for csproj filename + assembly name; PascalCase for the namespace
    IDENT_SNAKE="$(echo "$PROJECT_NAME" | tr '-' '_')"
    NS_PASCAL="$(echo "$PROJECT_NAME" | awk -F- '{for(i=1;i<=NF;i++) printf "%s", toupper(substr($i,1,1)) substr($i,2)}')"
    mkdir -p "$PROJECT/Editor"
    sed "s|Local\\.ModelProbe\\.EditorTools|Local.${NS_PASCAL}.EditorTools|g" \
        "$TEMPLATE_TRIGGER" > "$PROJECT/Editor/SkillTrigger.cs"
    # Only generate the editor csproj if there isn't one already (the agent may have written one)
    if ! ls "$PROJECT"/Editor/*.editor.csproj &>/dev/null 2>&1; then
      sed -e "s|model-probe|$PROJECT_NAME|g" \
          -e "s|model_probe|$IDENT_SNAKE|g" \
          -e "s|MODEL_PROBE|${NS_PASCAL^^}|g" \
          "$TEMPLATE_CSPROJ" > "$PROJECT/Editor/${IDENT_SNAKE}.editor.csproj"
    fi
    echo "auto-installed Editor/SkillTrigger.cs (project was missing it)"
  fi
fi

# Dedupe Editor csproj: if both hyphen-named and snake_case versions exist,
# delete the hyphen-named one (the editor auto-generates snake_case based on
# the .sbproj Ident; the hyphen-named one will be orphaned).
PROJECT_NAME="$(basename "$PROJECT")"
IDENT_SNAKE="$(echo "$PROJECT_NAME" | tr '-' '_')"
if [[ "$PROJECT_NAME" != "$IDENT_SNAKE" ]]; then
  for variant in "$PROJECT/Editor/${PROJECT_NAME}.editor.csproj" "$PROJECT/Code/${PROJECT_NAME}.csproj"; do
    if [[ -f "$variant" ]]; then
      echo "removing duplicate hyphen-named csproj: $variant"
      rm "$variant"
    fi
  done
fi

if [[ ! -x "$EDITOR_EXE" && ! -f "$EDITOR_EXE" ]]; then
  echo "error: editor binary missing at $EDITOR_EXE" >&2
  echo "       run sbox-doctor to verify the install" >&2
  exit 1
fi

if [[ $KILL_FIRST == 1 ]]; then
  echo "killing any running editor processes..."
  kill_editor
fi

# Translate Linux path → Wine Z: path
WINE_SBPROJ='Z:'"${SBPROJ//\//\\}"
echo "wine path: $WINE_SBPROJ"

LAUNCH_LOG="/tmp/sbox-launch-$$.log"
nohup protontricks-launch --appid "$EDITOR_APPID" "$EDITOR_EXE" -project "$WINE_SBPROJ" \
  </dev/null >"$LAUNCH_LOG" 2>&1 &
disown
echo "launched at $(date '+%H:%M:%S') (log: $LAUNCH_LOG)"

if [[ $WAIT_READY == 1 ]]; then
  # Ping SkillTrigger and wait for the result. This proves the editor's
  # event loop is alive AND the editor extension has compiled — the only
  # signal that actually matters before the next tool call.
  TRIG_DIR="$PROJECT/.sbox/skill-triggers"
  RES_DIR="$PROJECT/.sbox/skill-results"
  mkdir -p "$TRIG_DIR"
  PING_ID="$(date +%Y%m%d-%H%M%S)-$$-ready"
  printf 'ping' > "$TRIG_DIR/$PING_ID.txt"
  echo "waiting for editor to be ready (ping trigger $PING_ID)..."
  DEADLINE=$(( $(date +%s) + WAIT_READY_TIMEOUT ))
  while [[ $(date +%s) -lt $DEADLINE ]]; do
    if [[ -f "$RES_DIR/$PING_ID.json" ]]; then
      echo "editor ready ($(($(date +%s) - DEADLINE + WAIT_READY_TIMEOUT))s)"
      # Sanity-check the editor extension compiled clean. The ping fires
      # only if SkillTrigger.cs *did* compile — so success implicitly means
      # compile is OK — but if the GAME-side csproj has errors, those won't
      # block the ping (different assembly). Surface compile failures here
      # so they don't haunt the next tool call.
      LOGFILE="$HOME/.steam/root/steamapps/common/sbox/logs/sbox-dev.log"
      if [[ -f "$LOGFILE" ]]; then
        # Look at the most recent compile-result line for this project.
        # If it's "Failed", warn but don't exit non-zero — the editor IS
        # running, the agent may still want to proceed (e.g. to fix code
        # via sbox-recompile after this returns).
        LAST_COMPILE=$(tail -c 200000 "$LOGFILE" | grep -E "Compile of 'local\\.${IDENT_SNAKE}(\\.editor)?' (OK|Failed)" | tail -1)
        if echo "$LAST_COMPILE" | grep -q "Failed"; then
          echo "warning: $LAST_COMPILE — code changes won't take effect until you fix the error"
          echo "         see: tools/sbox-logs --errors --tail 10"
        fi
      fi
      exit 0
    fi
    sleep 2
  done
  echo "warning: editor still not ready after ${WAIT_READY_TIMEOUT}s (no SkillTrigger ping reply)"
  echo "         compile may still be in progress; the editor binary is running but the extension hasn't responded."
  echo "         check: tools/sbox-logs --errors --tail 20"
  exit 1
fi

if [[ $TAIL == 1 ]]; then
  # wait for editor to touch its log
  LOG="$HOME/.steam/root/steamapps/common/sbox/logs/sbox-dev.log"
  for _ in $(seq 1 60); do
    [[ -f "$LOG" ]] && break
    sleep 1
  done
  exec "$SCRIPT_DIR/sbox-logs" --follow --errors
fi
