#!/usr/bin/env python3
"""
sbox-screenshot — capture a screenshot or video of a project's scene from
the editor.

Architecture (trigger-file pattern):
  1. Ensure the project has an `Editor/` extension with `SkillTrigger.cs`
     installed. If absent, copy from templates/Editor/. This is a one-time
     install per project; the editor compiles it on first launch.
  2. Ensure the editor is running on the project. If not, launch it.
  3. Write a trigger file under `<project>/.sbox/skill-triggers/<ts>.txt`
     with content like "screenshot 1280x720" or "video".
  4. SkillTrigger polls that directory every editor frame (~4x/sec), reads
     the trigger, runs `ConsoleSystem.Run("screenshot_highres W H")`,
     deletes the trigger file.
  5. Tool watches the editor log for "Screenshot saved to:" or
     "Video recording finished:" line, resolves the Wine path to the real
     PNG/MP4, copies into <project>/captures/.

Why trigger files: zero xdotool/keyboard automation, works in edit mode
(no F5/play required), ~1s response time once editor is warm. Video and
play-mode-only captures still need the old sidecar Component path.

Usage:
  sbox-screenshot <project>                          quick 1280x720 PNG → <project>/captures/
  sbox-screenshot <project> --width 1920 --height 1080
  sbox-screenshot <project> --out coin-rush/captures/snap.png
  sbox-screenshot <project> --mode video --duration 5
  sbox-screenshot <project> --no-relaunch            reuse editor that's already up
"""
from __future__ import annotations
import argparse, os, re, shutil, subprocess, sys, time
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
SKILL_ROOT = SCRIPT_DIR.parent
TEMPLATE_EDITOR_DIR = SKILL_ROOT / "templates" / "Editor"
TEMPLATE_TRIGGER = TEMPLATE_EDITOR_DIR / "SkillTrigger.cs"
TEMPLATE_EDITOR_CSPROJ = TEMPLATE_EDITOR_DIR / "PROJECT.editor.csproj"
LAUNCH = SCRIPT_DIR / "sbox-launch"
LOG = Path.home() / ".steam/root/steamapps/common/sbox/logs/sbox-dev.log"
SCREENSHOTS_DIR = Path.home() / ".steam/root/steamapps/common/sbox/screenshots"


def project_csproj_name(project: Path) -> str:
    """Return the project's Code/<name>.csproj filename stem (with underscore)."""
    for f in (project / "Code").glob("*.csproj"):
        return f.stem
    # Fall back to project dir name with - → _
    return project.name.replace("-", "_")


def ensure_editor_extension(project: Path) -> bool:
    """Install Editor/SkillTrigger.cs + Editor/<name>.editor.csproj into the
    project if not present. Returns True if anything was installed (caller
    should plan for a recompile)."""
    editor_dir = project / "Editor"
    editor_dir.mkdir(parents=True, exist_ok=True)

    name = project.name  # e.g. "coin-rush"
    code_csproj = project_csproj_name(project)  # e.g. "coin_rush"
    namespace = "".join(p.capitalize() for p in name.split("-"))  # "CoinRush"

    trigger_dest = editor_dir / "SkillTrigger.cs"
    csproj_dest = editor_dir / f"{name}.editor.csproj"

    installed = False
    if not trigger_dest.exists():
        text = TEMPLATE_TRIGGER.read_text(encoding="utf-8")
        text = text.replace("Local.ModelProbe.EditorTools", f"Local.{namespace}.EditorTools")
        trigger_dest.write_text(text, encoding="utf-8")
        installed = True

    if not csproj_dest.exists():
        text = TEMPLATE_EDITOR_CSPROJ.read_text(encoding="utf-8")
        text = (text.replace("model-probe", name)
                    .replace("model_probe", code_csproj)
                    .replace("MODEL_PROBE", namespace.upper()))
        csproj_dest.write_text(text, encoding="utf-8")
        installed = True

    return installed


def write_trigger(project: Path, content: str) -> Path:
    """Drop a trigger file into <project>/.sbox/skill-triggers/."""
    d = project / ".sbox" / "skill-triggers"
    d.mkdir(parents=True, exist_ok=True)
    f = d / f"{time.strftime('%Y%m%d-%H%M%S')}-{os.getpid()}.txt"
    f.write_text(content, encoding="utf-8")
    return f


def editor_running_on(project: Path) -> bool:
    """Best-effort check: is the sbox-dev process running with this project?"""
    try:
        r = subprocess.run(["pgrep", "-af", "sbox-dev.exe"],
                           capture_output=True, text=True, timeout=3)
        for ln in r.stdout.splitlines():
            if str(project.name) in ln or str(project).replace("/", "\\") in ln:
                return True
        return False
    except Exception:
        return False



# Matches:
#   "Screenshot saved to: <path>"
#   "High-res screenshot saved to: <path>"
#   "Video recording finished: <a href="...">...</a>"  (mp4)
PATH_RE = re.compile(r"(?:High-res s|S)creenshot saved to:\s+(\S+)")
VIDEO_PATH_RE = re.compile(r'Video recording finished:[^"]*"([^"]+)"')
VIDEO_START_RE = re.compile(r'Video recording started:\s+(\S+)')


def _resolve_screenshot_path(raw: str) -> Path:
    p = raw
    if p.startswith(("Z:\\", "Z:/")):
        p = "/" + p[3:].replace("\\", "/")
    p = p.replace("\\", "/")
    candidate = Path(p)
    if candidate.is_absolute():
        return candidate
    # Relative — the engine logs "screenshots\<file>.png" rooted at the
    # installed-sbox base directory.
    return Path.home() / ".steam/root/steamapps/common/sbox" / p


def wait_for_screenshot(timeout: int, start_byte: int) -> Path | None:
    """Watch the log for a Screenshot saved line after `start_byte`."""
    deadline = time.time() + timeout
    while time.time() < deadline:
        time.sleep(2)
        if not LOG.exists():
            continue
        with LOG.open("r", encoding="utf-8", errors="replace") as f:
            f.seek(start_byte)
            text = f.read()
        for ln in text.splitlines():
            m = PATH_RE.search(ln)
            if m:
                p = _resolve_screenshot_path(m.group(1))
                if p.exists():
                    return p
    return None


def find_newest_screenshot(after_ts: float) -> Path | None:
    if not SCREENSHOTS_DIR.exists():
        return None
    cands = [p for p in SCREENSHOTS_DIR.glob("*.png") if p.stat().st_mtime > after_ts]
    if not cands:
        return None
    return max(cands, key=lambda p: p.stat().st_mtime)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("project")
    ap.add_argument("--scene", help="scene path relative to Assets/ (default: .sbproj StartupScene)")
    ap.add_argument("--width", type=int, default=1280)
    ap.add_argument("--height", type=int, default=720)
    ap.add_argument("--out", help="copy result to this path (default: <project>/captures/<name>.<ext>)")
    ap.add_argument("--no-relaunch", action="store_true",
        help="don't kill+relaunch the editor; just send F5 to the running editor "
             "(much faster — ~10s instead of 2-5min — but requires the editor to "
             "already be on the right project with the capture sidecar scene loaded)")
    ap.add_argument("--timeout", type=int, default=420,
        help="seconds to wait for editor compile + F5 + capture (default: 420; first run after a code change can take 5 min)")
    ap.add_argument("--no-keep", action="store_true",
        help="delete the sidecar scene after capture (default: keep it for re-runs)")
    ap.add_argument("--mode", choices=["screenshot", "video"], default="screenshot")
    ap.add_argument("--duration", type=float, default=5.0, help="video duration (sec)")
    ap.add_argument("--no-reencode", action="store_true",
        help="don't re-encode video to H.264; keep raw AV1+Opus from s&box")
    args = ap.parse_args()

    project = Path(args.project).resolve()
    if not project.is_dir():
        raise SystemExit(f"{project} is not a directory")

    # Default --out to <project>/captures/<timestamp>.<ext>
    if not args.out:
        captures = project / "captures"
        captures.mkdir(parents=True, exist_ok=True)
        ext = "mp4" if args.mode == "video" else "png"
        ts = time.strftime("%Y%m%d-%H%M%S")
        args.out = str(captures / f"{project.name}-{ts}.{ext}")

    # Install editor extension if missing (one-time per project)
    installed_extension = ensure_editor_extension(project)

    started_at = time.time()
    start_byte = LOG.stat().st_size if LOG.exists() else 0

    # Ensure editor is running on this project
    if not editor_running_on(project) and not args.no_relaunch:
        print(f"editor not running on {project.name}; launching...", file=sys.stderr)
        subprocess.run([str(LAUNCH), str(project)], check=False)
        # Wait for the editor to come up enough to compile the trigger extension.
        # If we just installed the extension, give it more time.
        ready_wait = 90 if installed_extension else 30
        time.sleep(ready_wait)
    elif installed_extension:
        # Editor already running but extension is new → user needs to restart
        # Trigger via launch tool's kill+relaunch
        print("just-installed editor extension needs a restart…", file=sys.stderr)
        subprocess.run([str(LAUNCH), "--kill"], check=False)
        time.sleep(2)
        subprocess.run([str(LAUNCH), str(project)], check=False)
        time.sleep(60)
    else:
        print("editor already running on project (trigger path is ~1s)", file=sys.stderr)

    # Build the trigger content
    if args.mode == "screenshot":
        trigger_content = f"screenshot {args.width}x{args.height}"
    else:
        # video-clip: SkillTrigger handles play→record→stop→exit-play as a
        # single sequence. We don't need to manage stop ourselves.
        trigger_content = f"video-clip {args.duration:g}"

    # Fire the trigger
    trigger_file = write_trigger(project, trigger_content)
    print(f"wrote trigger: {trigger_file.name} → {trigger_content}", file=sys.stderr)

    deadline = time.time() + args.timeout
    result: Path | None = None
    while time.time() < deadline:
        time.sleep(1)

        with LOG.open("r", encoding="utf-8", errors="replace") as f:
            f.seek(start_byte)
            tail = f.read()

        if args.mode == "screenshot":
            for ln in tail.splitlines():
                m = PATH_RE.search(ln)
                if m:
                    p = _resolve_screenshot_path(m.group(1))
                    if p.exists():
                        result = p
                        break
            if result:
                break
            continue

        # video mode: SkillTrigger drives the whole sequence; we just watch
        # for "Video recording finished" then resolve the path.
        m = VIDEO_PATH_RE.search(tail)
        if m:
            time.sleep(2)  # let encoder flush + skill-trigger exit play
            p = _resolve_screenshot_path(m.group(1))
            if p.exists():
                result = p
                break

    if result is None or not result.exists():
        # Last-ditch: pick the newest .png/.mp4 in screenshots/ since we started
        if SCREENSHOTS_DIR.exists():
            ext = ".mp4" if args.mode == "video" else ".png"
            cands = [p for p in SCREENSHOTS_DIR.glob(f"*{ext}") if p.stat().st_mtime > started_at - 1]
            if cands:
                result = max(cands, key=lambda p: p.stat().st_mtime)

    if not result or not result.exists():
        print("no screenshot/video file found.", file=sys.stderr)
        print(f"check log: {LOG} for SCREENSHOT_REQUEST / Screenshot saved entries", file=sys.stderr)
        sys.exit(2)

    if args.out:
        out = Path(args.out).expanduser().resolve()
        out.parent.mkdir(parents=True, exist_ok=True)
        # AV1 video → re-encode to H.264 for universal player compat
        if args.mode == "video" and shutil.which("ffmpeg") and not args.no_reencode:
            try:
                subprocess.run([
                    "ffmpeg", "-y", "-loglevel", "error",
                    "-i", str(result),
                    "-c:v", "libx264", "-preset", "fast", "-crf", "22", "-pix_fmt", "yuv420p",
                    "-c:a", "aac", "-b:a", "96k",
                    str(out),
                ], check=True)
                print(f"saved (re-encoded H.264): {out}", file=sys.stderr)
                print(out)
                return
            except subprocess.CalledProcessError as e:
                print(f"ffmpeg re-encode failed ({e}); copying raw AV1", file=sys.stderr)
        shutil.copy2(result, out)
        print(f"saved: {out}")
    else:
        print(f"saved: {result}")
        if args.mode == "video":
            print(
                "  note: AV1+Opus mp4 — may not play in older video players.\n"
                "  use --out PATH for an auto-re-encoded H.264 copy (needs ffmpeg).",
                file=sys.stderr,
            )


if __name__ == "__main__":
    main()
