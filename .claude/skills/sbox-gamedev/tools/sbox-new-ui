#!/usr/bin/env python3
"""
sbox-new-ui — scaffold a Razor UI panel for s&box (.razor + .razor.scss).

Usage:
  sbox-new-ui <Name> <project-dir>
  sbox-new-ui <Name> <project-dir> --subdir UI/Mode    place under Code/UI/Mode/
  sbox-new-ui <Name> <project-dir> --with-icon save    include a Material Icons icon
"""
from __future__ import annotations
import argparse, json, re, sys
from pathlib import Path

RAZOR_TEMPLATE = """@namespace {namespace}
@using Sandbox.UI
@inherits Panel

<root>
{icon_block}
\t<div class="title">@Title</div>
\t<div class="body">@ChildContent</div>
</root>

@code
{{
\t[Parameter] public string Title {{ get; set; }} = "{name}";
\t[Parameter] public RenderFragment ChildContent {{ get; set; }}

\tprotected override int BuildHash() => HashCode.Combine( Title );
}}
"""

SCSS_TEMPLATE = """{name}
{{
\tflex-direction: column;
\tpadding: 1rem;
\tgap: 0.5rem;

{icon_scss}\t.title
\t{{
\t\tfont-family: $title-font;
\t\tfont-size: 18px;
\t}}

\t.body
\t{{
\t\tfont-family: $body-font;
\t\tfont-size: 14px;
\t}}
}}
"""

def main():
    p = argparse.ArgumentParser()
    p.add_argument("name")
    p.add_argument("project_dir")
    p.add_argument("--subdir", default="UI", help="subdir under Code/ (default: UI)")
    p.add_argument("--with-icon", help="Material Icons name to include as a leading icon")
    args = p.parse_args()

    proj = Path(args.project_dir).resolve()
    if not proj.is_dir():
        print(f"error: {proj} is not a directory", file=sys.stderr); sys.exit(1)

    candidates = list(proj.glob("*.sbproj")) + ([proj / ".sbproj"] if (proj / ".sbproj").exists() else [])
    candidates = [c for c in candidates if c.is_file()]
    if not candidates:
        print(f"error: no .sbproj in {proj}", file=sys.stderr); sys.exit(1)
    data = json.loads(candidates[0].read_text(encoding="utf-8"))
    org = data.get("Org") or "local"
    ident = data.get("Ident") or proj.name
    parts = [s for s in [org.title().replace("_", ""), ident.title().replace("_", "")] if s and s.lower() != "local"]
    namespace = ".".join(parts) if parts else "Game"

    name = args.name
    if not re.match(r"^[A-Z][A-Za-z0-9_]*$", name):
        print(f"error: panel name must be PascalCase: got {name}", file=sys.stderr); sys.exit(1)

    icon_block = ""
    icon_scss = ""
    if args.with_icon:
        icon_block = f'\t<div class="icon">{args.with_icon}</div>\n'
        icon_scss = "\t.icon\n\t{\n\t\tfont-family: \"Material Icons\";\n\t\tfont-size: 24px;\n\t\tline-height: 1;\n\t}\n\n"

    razor = RAZOR_TEMPLATE.format(namespace=namespace, name=name, icon_block=icon_block)
    scss = SCSS_TEMPLATE.format(name=name, icon_scss=icon_scss)

    out_dir = proj / "Code" / args.subdir
    out_dir.mkdir(parents=True, exist_ok=True)
    razor_path = out_dir / f"{name}.razor"
    scss_path = out_dir / f"{name}.razor.scss"
    for p_ in (razor_path, scss_path):
        if p_.exists():
            print(f"error: {p_} already exists; refusing to overwrite", file=sys.stderr); sys.exit(1)

    razor_path.write_text(razor, encoding="utf-8")
    scss_path.write_text(scss, encoding="utf-8")

    print(f"wrote {razor_path}")
    print(f"wrote {scss_path}")
    print(f"namespace: {namespace}")
    if args.with_icon:
        print(f"icon: Material Icons '{args.with_icon}' (use sbox-icon to look up alternatives)")


if __name__ == "__main__":
    main()
