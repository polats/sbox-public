#!/usr/bin/env python3
"""
sbox-new-component — scaffold an s&box Component .cs file.

Usage:
  sbox-new-component <Name> <project-dir>
  sbox-new-component <Name> <project-dir> --networked
  sbox-new-component <Name> <project-dir> --triggers   add ITriggerListener
  sbox-new-component <Name> <project-dir> --update     include OnUpdate

Determines the project namespace from .sbproj (Org.Ident) and writes the
component into <project-dir>/Code/<Name>.cs (refuses to overwrite).
"""
from __future__ import annotations
import argparse, json, re, sys
from pathlib import Path

TEMPLATE = """using Sandbox;
{using_lines}

namespace {namespace};

public sealed class {name} : Component{interfaces}
{{
{sync_props}{members}
\tprotected override void OnStart()
\t{{
\t\tbase.OnStart();
\t}}
{on_update}{trigger_methods}}}
"""

def main():
    p = argparse.ArgumentParser()
    p.add_argument("name")
    p.add_argument("project_dir")
    p.add_argument("--networked", action="store_true", help="add a [Sync] example property")
    p.add_argument("--triggers", action="store_true", help="implement ITriggerListener")
    p.add_argument("--update", action="store_true", help="include OnUpdate stub")
    args = p.parse_args()

    proj = Path(args.project_dir).resolve()
    if not proj.is_dir():
        print(f"error: {proj} is not a directory", file=sys.stderr); sys.exit(1)

    # Find .sbproj
    candidates = list(proj.glob("*.sbproj")) + ([proj / ".sbproj"] if (proj / ".sbproj").exists() else [])
    candidates = [c for c in candidates if c.is_file()]
    if not candidates:
        print(f"error: no .sbproj in {proj}", file=sys.stderr); sys.exit(1)
    sbproj = candidates[0]
    data = json.loads(sbproj.read_text(encoding="utf-8"))
    org = data.get("Org") or "local"
    ident = data.get("Ident") or proj.name
    # Namespace convention seen in sandbox/bombroyale: Facepunch.BombRoyale, Sandbox
    parts = [s for s in [org.title().replace("_", ""), ident.title().replace("_", "")] if s and s.lower() != "local"]
    namespace = ".".join(parts) if parts else "Game"

    name = args.name
    if not re.match(r"^[A-Z][A-Za-z0-9_]*$", name):
        print(f"error: component name must be PascalCase: got {name}", file=sys.stderr); sys.exit(1)

    interfaces_list = []
    if args.triggers:
        interfaces_list.append("Component.ITriggerListener")
    interfaces = ", " + ", ".join(interfaces_list) if interfaces_list else ""

    using_lines = ""
    sync_props = ""
    if args.networked:
        sync_props = "\t[Sync] public int Score { get; set; }\n\n"

    members = ""
    on_update = ""
    if args.update:
        on_update = "\n\tprotected override void OnUpdate()\n\t{\n\t\t// per-frame logic\n\t}\n"

    trigger_methods = ""
    if args.triggers:
        trigger_methods = """
\tvoid Component.ITriggerListener.OnTriggerEnter( Collider other )
\t{
\t\t// other.GameObject entered our trigger
\t}

\tvoid Component.ITriggerListener.OnTriggerExit( Collider other )
\t{
\t}
"""

    code = TEMPLATE.format(
        using_lines=using_lines,
        namespace=namespace,
        name=name,
        interfaces=interfaces,
        sync_props=sync_props,
        members=members,
        on_update=on_update,
        trigger_methods=trigger_methods,
    )

    out_dir = proj / "Code"
    out_dir.mkdir(parents=True, exist_ok=True)
    out_file = out_dir / f"{name}.cs"
    if out_file.exists():
        print(f"error: {out_file} already exists; refusing to overwrite", file=sys.stderr); sys.exit(1)
    out_file.write_text(code, encoding="utf-8")

    print(f"wrote {out_file}")
    print(f"namespace: {namespace}")
    print(f"reload the editor to pick up the new component (auto-compile on save)")


if __name__ == "__main__":
    main()
