#!/usr/bin/env python3
"""
sbox-model-info — get verified bounding-box dimensions for s&box models.

s&box has no built-in `model_info` console command. This tool uses the
engine itself as ground truth by:
  1. Writing a scene under `<repo>/model-probe/Assets/scenes/probe.scene`
     that holds a single `Local.ModelProbe.ModelProbe` component with the
     requested model paths as a [Property].
  2. Killing any running editor and launching the model-probe project.
  3. Waiting for the editor to compile + load the scene + log
     `BOUNDS_PROBE_DONE`.
  4. Parsing the log for `BOUNDS_PROBE <path> mins=… maxs=… size=…` lines.
  5. Printing a table.

Usage:
  sbox-model-info models/citizen_human/citizen_human_male.vmdl
  sbox-model-info models/citizen_props/coin01.vmdl models/sbox_props/trees/oak/tree_oak_big_a.vmdl
  sbox-model-info --query "citizen_human"     # use sbox-models substring search to expand
"""
from __future__ import annotations
import argparse, json, os, re, subprocess, sys, time, uuid
from pathlib import Path

REPO = Path("/home/paul/projects/sbox-public")
PROBE = REPO / "model-probe"
SCENE = PROBE / "Assets" / "scenes" / "probe.scene"
SCENE_GUID = "33333333-0000-0000-0000-000000000001"
GO_GUID = "33333333-0000-0000-0000-000000000010"
CMP_GUID = "33333333-0000-0000-0000-000000000011"
LOG = Path.home() / ".steam/root/steamapps/common/sbox/logs/sbox-dev.log"

SCRIPT_DIR = Path(__file__).resolve().parent
LAUNCH = SCRIPT_DIR / "sbox-launch"

# Match either "<Scene> - s&box editor" (the scene-editor window) or just "s&box editor"
EDITOR_WIN_TITLE = "s&box editor"


def send_f5_to_editor() -> bool:
    """Locate the editor's main window and send F5 to toggle play mode.
    Returns True if F5 was dispatched, False otherwise."""
    try:
        r = subprocess.run(
            ["xdotool", "search", "--name", EDITOR_WIN_TITLE],
            capture_output=True, text=True, timeout=5,
        )
        wids = [w for w in r.stdout.split() if w.strip()]
        if not wids:
            return False
        # Prefer the scene-editor window over the launcher (it has a title like "Probe - s&box editor")
        target = wids[0]
        for w in wids:
            name = subprocess.run(
                ["xdotool", "getwindowname", w],
                capture_output=True, text=True, timeout=2,
            ).stdout.strip()
            if " - " in name:
                target = w
                break
        # Activate, then send F5
        subprocess.run(["xdotool", "windowactivate", "--sync", target], timeout=5, check=False)
        time.sleep(0.3)
        subprocess.run(["xdotool", "key", "--window", target, "F5"], timeout=5, check=False)
        return True
    except Exception as e:
        print(f"xdotool error: {e}", file=sys.stderr)
        return False

LIFECYCLE_NULLS = {
    "OnComponentDestroy": None, "OnComponentDisabled": None,
    "OnComponentEnabled": None, "OnComponentFixedUpdate": None,
    "OnComponentStart": None,   "OnComponentUpdate": None,
}


def write_scene(model_paths: list[str]) -> None:
    SCENE.parent.mkdir(parents=True, exist_ok=True)
    scene = {
        "__guid": SCENE_GUID,
        "GameObjects": [
            {
                "__guid": GO_GUID, "__version": 2, "Flags": 0,
                "Name": "Probe", "Position": "0,0,0", "Rotation": "0,0,0,1",
                "Scale": "1,1,1", "Tags": "", "Enabled": True,
                "NetworkMode": 2, "NetworkFlags": 0, "NetworkOrphaned": 0,
                "NetworkTransmit": True, "OwnerTransfer": 1,
                "Components": [
                    {
                        "__type": "Local.ModelProbe.ModelProbe",
                        "__guid": CMP_GUID,
                        "__enabled": True, "Flags": 0,
                        **LIFECYCLE_NULLS,
                        "ModelPaths": model_paths,
                    }
                ],
                "Children": [],
            }
        ],
        "SceneProperties": {
            "NetworkInterpolation": True, "TimeScale": 1,
            "WantsSystemScene": False, "Metadata": {},
        },
        "ResourceVersion": 3, "Title": "Probe",
        "Description": "Model bounds probe. Generated by sbox-model-info.",
        "__references": [], "__version": 3,
    }
    SCENE.write_text(json.dumps(scene, indent=2), encoding="utf-8")


def prime_open_scene() -> None:
    """Mark probe.scene as the open scene so the editor restores it on launch."""
    setter = SCRIPT_DIR / "sbox-set-startup-scene"
    subprocess.run([str(setter), str(PROBE), "scenes/probe.scene"], check=True)


def parse_log_for_bounds(_unused_started: int = 0) -> tuple[dict, bool]:
    """Read the most-recent BOUNDS_PROBE_START → BOUNDS_PROBE_DONE block from
    the log. Returns (results, done). Done=True only if the DONE marker is
    present after the last START."""
    if not LOG.exists():
        return {}, False
    text = LOG.read_text(encoding="utf-8", errors="replace")
    last_start = text.rfind("BOUNDS_PROBE_START")
    if last_start < 0:
        return {}, False
    tail = text[last_start:]
    done = "BOUNDS_PROBE_DONE" in tail
    results: dict[str, dict] = {}
    line_re = re.compile(
        r"BOUNDS_PROBE\s+(\S+)\s+mins=([\-\d.]+),([\-\d.]+),([\-\d.]+)\s+"
        r"maxs=([\-\d.]+),([\-\d.]+),([\-\d.]+)\s+size=([\-\d.]+),([\-\d.]+),([\-\d.]+)"
    )
    err_re = re.compile(r"BOUNDS_PROBE\s+(\S+)\s+ERROR=(.+?)\s*$")
    for ln in tail.splitlines():
        m = line_re.search(ln)
        if m:
            results[m.group(1)] = {
                "mins": (float(m.group(2)), float(m.group(3)), float(m.group(4))),
                "maxs": (float(m.group(5)), float(m.group(6)), float(m.group(7))),
                "size": (float(m.group(8)), float(m.group(9)), float(m.group(10))),
            }
            continue
        m = err_re.search(ln)
        if m:
            results[m.group(1)] = {"error": m.group(2)}
    return results, done


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("paths", nargs="*", help="model paths to probe (e.g. models/citizen_human/citizen_human_male.vmdl)")
    ap.add_argument("--query", help="instead of paths, use sbox-models to find paths and probe them")
    ap.add_argument("--timeout", type=int, default=120, help="max seconds to wait for the editor to load + log results")
    args = ap.parse_args()

    paths = list(args.paths)
    if args.query:
        models_tool = SCRIPT_DIR / "sbox-models"
        r = subprocess.run([str(models_tool), args.query, "-n", "20"], capture_output=True, text=True)
        for ln in r.stdout.splitlines():
            ln = ln.strip()
            if ln.startswith("models/") and ln.endswith(".vmdl"):
                paths.append(ln)

    if not paths:
        ap.print_help()
        sys.exit(1)

    print(f"probing {len(paths)} model(s):", file=sys.stderr)
    for p in paths:
        print(f"  • {p}", file=sys.stderr)

    write_scene(paths)
    print("scene written", file=sys.stderr)

    # Kill editor, prime scene, launch.
    subprocess.run([str(LAUNCH), "--kill"], check=False)
    time.sleep(1)
    prime_open_scene()
    started = int(time.time())
    subprocess.run([str(LAUNCH), str(PROBE)], check=False)

    print(f"editor launching at {time.strftime('%H:%M:%S')} (will wait up to {args.timeout}s)...", file=sys.stderr)

    # Wait for the editor window to be ready, then send F5 to enter play mode
    # (so the probe Component's OnStart fires). The component logs each model's
    # bounds. After bounds are captured, we send F5 again to leave play.
    f5_sent = False
    play_started_at = None
    deadline = time.time() + args.timeout
    while time.time() < deadline:
        time.sleep(2)

        if not f5_sent:
            if send_f5_to_editor():
                print(f"sent F5 (enter play) at {time.strftime('%H:%M:%S')}", file=sys.stderr)
                f5_sent = True
                play_started_at = time.time()

        results, done = parse_log_for_bounds(started)
        if done and len(results) >= len(paths):
            break
        if all(p in results for p in paths):
            break
    else:
        print(f"timeout after {args.timeout}s — partial results below", file=sys.stderr)

    if f5_sent and play_started_at is not None:
        # Leave play mode so the editor returns to edit state for the next run
        time.sleep(0.5)
        send_f5_to_editor()

    results, _ = parse_log_for_bounds(started)
    if not results:
        print("no BOUNDS_PROBE entries in log — probe didn't run", file=sys.stderr)
        print("check `sbox-logs --category compile --tail 20` for build errors", file=sys.stderr)
        sys.exit(2)

    # Print results table
    BOLD, DIM, END = "\033[1m", "\033[2m", "\033[0m"
    print(f"\n{BOLD}{'path':<60} {'size x×y×z (inches)':<30} suggested scale{END}")
    for p in paths:
        info = results.get(p)
        if info is None:
            print(f"  {p:<60} {DIM}(no result){END}")
            continue
        if "error" in info:
            print(f"  {p:<60} ERROR={info['error']}")
            continue
        sx, sy, sz = info["size"]
        biggest = max(sx, sy, sz)
        # Suggest a scale so the biggest dimension is ~70 inches (human-sized)
        # (use 1.0 if already human-sized, smaller for trees, larger for coins)
        suggest = 70 / biggest if biggest > 0 else 1.0
        print(f"  {p:<60} {f'{sx:.1f} × {sy:.1f} × {sz:.1f}':<30} {DIM}scale ≈ {suggest:.2f} for ~human size{END}")


if __name__ == "__main__":
    main()
