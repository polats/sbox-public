#!/usr/bin/env python3
"""
sbox-model-info — get verified bounding-box dimensions for s&box models.

Uses the trigger-file pattern (see SkillTrigger.cs): writes a
`probe-models` trigger into model-probe's `.sbox/skill-triggers/`,
SkillTrigger reads it in edit mode, calls `Model.Load(path).Bounds`
for each path, logs `BOUNDS_PROBE …` lines. Tool parses the log.

No F5, no play mode, no xdotool. First call after editor cold-start
needs ~30s for compile; warm calls are sub-second.

Usage:
  sbox-model-info models/citizen_human/citizen_human_male.vmdl
  sbox-model-info models/citizen_props/coin01.vmdl models/sbox_props/trees/oak/tree_oak_big_a.vmdl
  sbox-model-info --query "citizen_human"     # expand via sbox-models first
  sbox-model-info --no-relaunch <paths...>    # reuse running editor
"""
from __future__ import annotations
import argparse, os, re, subprocess, sys, time
from pathlib import Path

REPO = Path("/home/paul/projects/sbox-public")
PROBE = REPO / "model-probe"
LOG = Path.home() / ".steam/root/steamapps/common/sbox/logs/sbox-dev.log"

SCRIPT_DIR = Path(__file__).resolve().parent
LAUNCH = SCRIPT_DIR / "sbox-launch"


def detect_running_project() -> Path | None:
    """Return the absolute path of the project the editor is currently on
    (by parsing the running sbox-dev.exe command line), or None."""
    try:
        r = subprocess.run(["pgrep", "-af", "sbox-dev.exe"],
                           capture_output=True, text=True, timeout=3)
    except Exception:
        return None
    for ln in r.stdout.splitlines():
        # The arg looks like: -project Z:\home\paul\projects\sbox-public\<name>\<name>.sbproj
        m = re.search(r"-project\s+Z:\\([^ ]+)\.sbproj", ln)
        if m:
            wine_path = m.group(1)
            linux = "/" + wine_path.replace("\\", "/")
            sbproj = Path(linux + ".sbproj")
            if sbproj.exists():
                return sbproj.parent
    return None


def write_trigger(project: Path, content: str) -> Path:
    """Drop a trigger file into <project>/.sbox/skill-triggers/."""
    d = project / ".sbox" / "skill-triggers"
    d.mkdir(parents=True, exist_ok=True)
    f = d / f"{time.strftime('%Y%m%d-%H%M%S')}-{os.getpid()}-probe.txt"
    f.write_text(content, encoding="utf-8")
    return f


def ensure_skill_trigger_installed(project: Path) -> bool:
    """Check that this project has Editor/SkillTrigger.cs installed. Returns
    True if the install was performed (so caller knows to give the editor
    time to recompile)."""
    if (project / "Editor" / "SkillTrigger.cs").exists():
        return False
    # Delegate to sbox-screenshot's helper if absent
    screenshot = SCRIPT_DIR / "sbox-screenshot"
    # Easiest path: import the helper. Both tools live in the same dir.
    src = SKILL_ROOT / "templates" / "Editor" / "SkillTrigger.cs"
    csproj_template = SKILL_ROOT / "templates" / "Editor" / "PROJECT.editor.csproj"
    name = project.name
    code_csproj = next((f.stem for f in (project / "Code").glob("*.csproj")), name.replace("-", "_"))
    namespace = "".join(p.capitalize() for p in name.split("-"))

    editor_dir = project / "Editor"
    editor_dir.mkdir(parents=True, exist_ok=True)

    trigger_dest = editor_dir / "SkillTrigger.cs"
    text = src.read_text(encoding="utf-8")
    text = text.replace("Local.ModelProbe.EditorTools", f"Local.{namespace}.EditorTools")
    trigger_dest.write_text(text, encoding="utf-8")

    csproj_dest = editor_dir / f"{name}.editor.csproj"
    text = csproj_template.read_text(encoding="utf-8")
    text = (text.replace("model-probe", name)
                .replace("model_probe", code_csproj)
                .replace("MODEL_PROBE", namespace.upper()))
    csproj_dest.write_text(text, encoding="utf-8")
    return True


SKILL_ROOT = SCRIPT_DIR.parent


def parse_log_for_bounds() -> tuple[dict, bool]:
    """Find the most-recent BOUNDS_PROBE_START → BOUNDS_PROBE_DONE block."""
    if not LOG.exists():
        return {}, False
    text = LOG.read_text(encoding="utf-8", errors="replace")
    last_start = text.rfind("BOUNDS_PROBE_START")
    if last_start < 0:
        return {}, False
    tail = text[last_start:]
    done = "BOUNDS_PROBE_DONE" in tail
    results: dict[str, dict] = {}
    line_re = re.compile(
        r"BOUNDS_PROBE\s+(\S+)\s+mins=([\-\d.]+),([\-\d.]+),([\-\d.]+)\s+"
        r"maxs=([\-\d.]+),([\-\d.]+),([\-\d.]+)\s+size=([\-\d.]+),([\-\d.]+),([\-\d.]+)"
    )
    err_re = re.compile(r"BOUNDS_PROBE\s+(\S+)\s+ERROR=(.+?)\s*$")
    for ln in tail.splitlines():
        m = line_re.search(ln)
        if m:
            results[m.group(1)] = {
                "mins": (float(m.group(2)), float(m.group(3)), float(m.group(4))),
                "maxs": (float(m.group(5)), float(m.group(6)), float(m.group(7))),
                "size": (float(m.group(8)), float(m.group(9)), float(m.group(10))),
            }
            continue
        m = err_re.search(ln)
        if m:
            results[m.group(1)] = {"error": m.group(2)}
    return results, done


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("paths", nargs="*", help="model paths (e.g. models/citizen_human/citizen_human_male.vmdl)")
    ap.add_argument("--query", help="instead of paths, use sbox-models to find paths and probe them")
    ap.add_argument("--no-relaunch", action="store_true",
        help="don't launch the editor — assume it's already running on model-probe")
    ap.add_argument("--timeout", type=int, default=120)
    args = ap.parse_args()

    paths = list(args.paths)
    if args.query:
        models_tool = SCRIPT_DIR / "sbox-models"
        r = subprocess.run([str(models_tool), args.query, "-n", "20"],
                           capture_output=True, text=True)
        for ln in r.stdout.splitlines():
            ln = ln.strip()
            if ln.startswith("models/") and ln.endswith(".vmdl"):
                paths.append(ln)

    if not paths:
        ap.print_help()
        sys.exit(1)

    print(f"probing {len(paths)} model(s):", file=sys.stderr)
    for p in paths:
        print(f"  • {p}", file=sys.stderr)

    # Decide which project to write the trigger to. Prefer the project the
    # editor is currently running on (any project with SkillTrigger handles
    # `probe-models` triggers). Otherwise fall back to model-probe and
    # launch the editor on it.
    target = detect_running_project()
    if target is None:
        target = PROBE
        if not args.no_relaunch:
            print(f"editor not running; launching on {target.name}…", file=sys.stderr)
            subprocess.run([str(LAUNCH), str(target)], check=False)
            time.sleep(30)
    else:
        print(f"editor running on {target.name} — writing trigger there", file=sys.stderr)

    installed = ensure_skill_trigger_installed(target)
    if installed:
        print("installed Editor/SkillTrigger.cs in target — needs editor restart…", file=sys.stderr)
        subprocess.run([str(LAUNCH), "--kill"], check=False)
        time.sleep(2)
        subprocess.run([str(LAUNCH), str(target)], check=False)
        time.sleep(45)

    trigger_content = "probe-models\n" + "\n".join(paths)
    trigger = write_trigger(target, trigger_content)
    print(f"wrote trigger: {trigger.name}", file=sys.stderr)

    deadline = time.time() + args.timeout
    while time.time() < deadline:
        time.sleep(1)
        results, done = parse_log_for_bounds()
        if done and len(results) >= len(paths):
            break
        if all(p in results for p in paths):
            break

    results, _ = parse_log_for_bounds()
    if not results:
        print("no BOUNDS_PROBE entries in log — probe didn't run.", file=sys.stderr)
        print("  • editor running and warmed up?", file=sys.stderr)
        print("  • model-probe has Editor/SkillTrigger.cs installed?", file=sys.stderr)
        sys.exit(2)

    BOLD, DIM, END = "\033[1m", "\033[2m", "\033[0m"
    print(f"\n{BOLD}{'path':<60} {'size x×y×z (inches)':<30} suggested scale{END}")
    for p in paths:
        info = results.get(p)
        if info is None:
            print(f"  {p:<60} {DIM}(no result){END}")
            continue
        if "error" in info:
            print(f"  {p:<60} ERROR={info['error']}")
            continue
        sx, sy, sz = info["size"]
        biggest = max(sx, sy, sz)
        suggest = 70 / biggest if biggest > 0 else 1.0
        print(f"  {p:<60} {f'{sx:.1f} × {sy:.1f} × {sz:.1f}':<30} {DIM}scale ≈ {suggest:.3f} for ~human size{END}")


if __name__ == "__main__":
    main()
