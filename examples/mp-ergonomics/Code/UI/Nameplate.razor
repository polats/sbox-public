@using System
@using Sandbox
@using Sandbox.UI
@inherits PanelComponent
@namespace Local.MpErgonomics

@if ( Player.IsValid() && !Player.IsLocal )
{
	<root>
		<div class="card">
			<div class="avatar-wrap">
				@if ( Player.IsTalking )
				{
					<div class="speaking-glow" style="opacity: @GetGlow(); transform: scale( @GetScale() )"></div>
				}
				<div class="avatar" style="background-color: @AvatarColor();">
					<label class="initial">@(Player.PlayerName.Substring(0,1))</label>
				</div>
			</div>
			<label class="name @(Player.IsFriend ? "friend" : "")">@Player.PlayerName @(Player.IsFriend ? "★" : "")</label>
		</div>
		<div class="health-bar">
			<div class="fill" style="width: @(Player.Health.ToString("0"))%; background-color: @HealthColor();"></div>
		</div>
	</root>
}

@code
{
	[Property] public FakePlayer Player { get; set; }

	private static readonly string[] Palette = new[] {
		"rgba(220,90,90,1)", "rgba(90,170,220,1)", "rgba(120,200,120,1)",
		"rgba(220,170,90,1)", "rgba(180,120,220,1)", "rgba(90,200,200,1)"
	};

	private string AvatarColor()
	{
		if ( Player is null ) return "rgba(128,128,128,1)";
		var hash = System.Math.Abs( Player.PlayerName.GetHashCode() );
		return Palette[hash % Palette.Length];
	}

	private string HealthColor()
	{
		if ( Player is null ) return "rgba(80,200,80,1)";
		var pct = Player.Health / 100f;
		int r = (int)(255 * (1 - pct));
		int g = (int)(200 * pct);
		return $"rgba({r},{g},80,1)";
	}

	private string GetGlow()
	{
		var s = 0.4f + (float)System.Math.Sin( Time.Now * 6f ) * 0.4f;
		return MathX.Clamp( s, 0.2f, 0.9f ).ToString( "0.##" );
	}

	private string GetScale()
	{
		var s = 1.1f + (float)System.Math.Sin( Time.Now * 6f ) * 0.2f;
		return s.ToString( "0.##" );
	}

	protected override int BuildHash() => System.HashCode.Combine(
		Player?.PlayerName, Player?.Health, Player?.IsTalking, Player?.IsFriend, Time.Now );
}
