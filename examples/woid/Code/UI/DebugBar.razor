@namespace Woid
@using System
@using System.Linq
@using Sandbox
@using Sandbox.UI
@inherits PanelComponent

<root>
	<div class="bar">
		<div class="btn @(IsPaused ? "active" : "")" onclick=@TogglePause>
			@(IsPaused ? "▶ RESUME" : "⏸ PAUSE")
		</div>
		<div class="btn" onclick=@ToggleFly>
			@(FlyEnabled ? "🎥 LOCKED VIEW" : "🎥 FLY CAM")
		</div>
		<div class="hint">Click chair / bed / mug to direct the nearest character.</div>
	</div>
</root>

@code
{
	public bool IsPaused { get; private set; }
	public bool FlyEnabled { get; private set; }

	void TogglePause()
	{
		Log.Info( "[DebugBar] TogglePause clicked" );
		var client = Scene.GetAllComponents<WoidClient>().FirstOrDefault();
		if ( client.IsValid() )
		{
			client.TogglePaused();
			IsPaused = client.Paused;
		}
	}

	void ToggleFly()
	{
		Log.Info( "[DebugBar] ToggleFly clicked" );
		// FlyCamera starts disabled in scene; Scene.GetAllComponents<T>() only
		// returns enabled ones, so walk the GO tree to find it.
		FlyCamera fly = null;
		foreach ( var go in Scene.GetAllObjects( true ) )
		{
			fly = go.Components.Get<FlyCamera>( includeDisabled: true );
			if ( fly != null ) break;
		}
		if ( fly.IsValid() )
		{
			fly.Enabled = !fly.Enabled;
			FlyEnabled = fly.Enabled;
			Log.Info( $"[DebugBar] FlyCamera.Enabled = {fly.Enabled}" );
		}
		else
		{
			Log.Warning( "[DebugBar] no FlyCamera component found in scene" );
		}
	}

	protected override void OnUpdate()
	{
		// Keep in sync if something else flips the values.
		var client = Scene.GetAllComponents<WoidClient>().FirstOrDefault();
		if ( client.IsValid() ) IsPaused = client.Paused;
		// FlyCamera may be disabled; same dance.
		foreach ( var go in Scene.GetAllObjects( true ) )
		{
			var fly = go.Components.Get<FlyCamera>( includeDisabled: true );
			if ( fly != null ) { FlyEnabled = fly.Enabled; break; }
		}
	}

	protected override int BuildHash() => HashCode.Combine( IsPaused, FlyEnabled );
}
