@namespace Woid
@using System
@using System.Linq
@using Sandbox
@using Sandbox.UI
@inherits PanelComponent

<root>
	<div class="btn @(IsPaused ? "active" : "")" onclick=@TogglePause>
		<i>@(IsPaused ? "play_arrow" : "pause")</i><span>@(IsPaused ? "resume" : "pause")</span>
	</div>
	<div class="hint">hold right-mouse to move camera · click chair · bed · mug to direct</div>
</root>

@code
{
	public bool IsPaused { get; private set; }

	void TogglePause()
	{
		Log.Info( "[DebugBar] TogglePause clicked" );
		var client = Scene.GetAllComponents<WoidClient>().FirstOrDefault();
		if ( client.IsValid() )
		{
			client.TogglePaused();
			IsPaused = client.Paused;
		}
	}

	protected override void OnUpdate()
	{
		var client = Scene.GetAllComponents<WoidClient>().FirstOrDefault();
		if ( client.IsValid() ) IsPaused = client.Paused;
	}

	protected override int BuildHash() => HashCode.Combine( IsPaused );
}
